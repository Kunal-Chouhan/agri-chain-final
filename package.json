{
  "name": "agri-chain-transparency",
  "version": "1.1.0",
  "description": "Blockchain-based supply chain transparency for agricultural produce",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:demo": "node scripts/seedDemo.js",
    "retry:anchors": "node scripts/retryAnchors.js",
    "chain:node": "hardhat node",
    "chain:compile": "hardhat compile",
    "chain:deploy": "hardhat run scripts/deploy.js --network localhost",
    "demo": "node scripts/seedDemo.js && node server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "ethers": "^6.13.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0"
  },
  "devDependencies": {
    "hardhat": "^2.22.0"
  }
}